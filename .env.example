# ==========================================
# SERVER-SIDE SECRETS (Never exposed to browser)
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls in /api/* serverless functions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional server-side app URL override
APP_URL="MY_APP_URL"

# ==========================================
# CLIENT-SAFE / PUBLIC CONFIGURATION (Vite)
# ==========================================
# VITE_APP_URL: Public production URL for OAuth redirects, callbacks, and links.
VITE_APP_URL="https://your-production-domain.com"

# Supabase Authentication & Database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
